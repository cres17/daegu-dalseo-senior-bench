# This repository intentionally publishes documentation and source code only.
# Raw data, intermediate datasets, generated maps, notebooks, caches, and
# local environments stay out of version control.
/*
!/.gitignore
!/README.md

!/01_business_understanding/
!/01_business_understanding/*.md

!/02_data_understanding/
